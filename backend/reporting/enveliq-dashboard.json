    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Reviewed, archived and binned per hour",
      "description": "How quickly the queue is being cleared.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (outcome) (increase(enveliq_message_actions_total[1h]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
