# Enveliq settings. Do not put mail passwords or API keys here: those are
# entered in the app and stored encrypted.

# The address people use in their browser. Must be https:// unless it is
# localhost. Passkeys and single sign-on are tied to this address.
ENVELIQ_PUBLIC_URL=http://localhost:8765

# Open Enveliq at http://IP-ADDRESS:8765 on a network you trust, with no reverse
# proxy and no SSH tunnel. All three lines are needed; read docs/NETWORK_ACCESS.md first
# (passwords and sign-in cookies travel unencrypted, and passkeys and Microsoft sign-in will not work).
# ENVELIQ_PUBLISH=0.0.0.0
# ENVELIQ_PUBLIC_URL=http://192.168.1.50:8765
# ENVELIQ_ALLOW_INSECURE_PUBLIC_URL=1

ENVELIQ_DATA_DIR=./data
ENVELIQ_BIND=127.0.0.1
ENVELIQ_PORT=8765
ENVELIQ_IDLE_LOCK_SECONDS=1800
ENVELIQ_SESSION_TTL_SECONDS=1800

# Optional: preset the one-time setup code (otherwise one is generated and
# written to setup-code.txt in the data folder).
# ENVELIQ_SETUP_CODE=

# Advanced. Defaults are derived from ENVELIQ_PUBLIC_URL.
# ENVELIQ_ALLOWED_HOSTS=enveliq.example.com,localhost,127.0.0.1
# ENVELIQ_ALLOWED_ORIGINS=https://enveliq.example.com
# ENVELIQ_ALLOW_NON_LOOPBACK=0     # only behind an HTTPS reverse proxy
# ENVELIQ_OIDC_ALLOW_HTTP=0        # allow an http:// sign-in provider (not recommended)

# Proton Mail Bridge (see docs/PROTON_BRIDGE.md).
# The certificate exported from Bridge. Enveliq trusts only this one.
# ENVELIQ_BRIDGE_CA_FILE=/etc/enveliq/proton-bridge.crt
# If set, Enveliq contacts only these Bridge hosts (comma separated). If empty,
# any private or local IP address is allowed.
# ENVELIQ_BRIDGE_ALLOWED_HOSTS=172.30.0.1

# Automatic sync: minutes between checks for new mail (minimum 2; 0 turns it off).
# Optional: an administrator can set this in the app (Administration, Automatic sync). A value here overrides the app.
# It runs only while Enveliq is unlocked and does not keep it from locking when idle.
# ENVELIQ_SYNC_MINUTES=10

# Reminders, calendars and To-do lists: services on your own network that Enveliq may call (comma separated host names,
# IP addresses or networks). Anything else on a private network is refused. Optional: Administration, Reminders does the same.
# ENVELIQ_NOTIFY_ALLOWED_HOSTS=192.168.1.0/24,homeassistant.local

# Vault key: lets Enveliq unlock itself after every restart (good with single sign-on).
# Make one with:  openssl rand -hex 32
# Keep a copy somewhere safe and separate from your backups: without it the data cannot be opened.
# Leave it unset to type a vault passphrase after each restart instead. See docs/VAULT_KEY.md.
# ENVELIQ_VAULT_KEY=
# Stronger option: a key file outside the data volume (also needs the /keys volume in docker-compose.yml).
# ENVELIQ_KEY_DIR=/opt/enveliq/keys

# Email services that use an app password: Gmail, iCloud, Yahoo, Fastmail, other IMAP (see docs/EMAIL_SERVICES.md).
# Normally leave both empty: Enveliq then connects to public mail servers on the standard
# secure ports only (IMAP 993 or 143 with STARTTLS; SMTP 465 or 587), checking the certificate.
# If set, ONLY these mail servers are contacted (comma separated, IMAP and SMTP names), and they
# may be on your own network or use other ports.
# ENVELIQ_MAIL_ALLOWED_HOSTS=mail.example.org
# An extra certificate to trust for a mail server with a private certificate authority.
# ENVELIQ_MAIL_CA_FILE=/etc/enveliq/mail-ca.crt

# AI summaries from a model you run yourself (see docs/AI_SUMMARIES.md).
# Optional: an administrator can set this up in the app instead (Setup guide, step 2).
# Settings here take priority over the app. Leave ENVELIQ_LLM_URL empty to keep AI off.
# ENVELIQ_LLM_URL=http://192.168.1.10:8088/v1/chat/completions
# ENVELIQ_LLM_MODEL=your-model-name
# ENVELIQ_LLM_API_KEY=            # only if the server wants a key
# ENVELIQ_LLM_PROVIDER=openai     # only for a cloud service (see docs/AI_SUMMARIES.md); leave out for a server on your network
# If set, only these AI hosts are contacted (comma separated). If empty, any private or local IP address is allowed.
# ENVELIQ_LLM_ALLOWED_HOSTS=192.168.1.10

# Reporting for Grafana and others is set up in the app (Administration, Reporting; see docs/REPORTING.md).
# Optional safety limit: if set, reports (Loki, webhook) may only be sent to these hosts (comma separated).
# ENVELIQ_REPORT_ALLOWED_HOSTS=alloy.lan
