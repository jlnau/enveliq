          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (mailbox) (sum_over_time({job=\"enveliq\", event=\"sync_completed\"} | json | unwrap added [$__interval]))",
          "refId": "A",
          "legendFormat": "{{mailbox}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
