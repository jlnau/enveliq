          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "quantile_over_time(0.95, {job=\"enveliq\", event=\"sync_completed\"} | json | unwrap duration_ms [$__interval]) by (mailbox) / 1000",
          "refId": "A",
          "legendFormat": "{{mailbox}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
